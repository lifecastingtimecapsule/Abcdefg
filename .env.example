# Supabase project settings for local development / Vercel
#
# このファイルを .env.local などにコピーして値を設定してください。
# 実際の値は Supabase ダッシュボードの Project Settings > API から取得します。

VITE_SUPABASE_PROJECT_ID=your-supabase-project-ref
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# データ移行用（Service Role Key）。スクリプトやサーバーでのみ使用し、クライアントに公開しないこと。
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
