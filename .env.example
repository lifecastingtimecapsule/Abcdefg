# Supabase project settings for local development / Vercel
#
# このファイルを .env.local などにコピーして値を設定してください。
# 実際の値は Supabase ダッシュボードの Project Settings > API から取得します。

VITE_SUPABASE_PROJECT_ID=your-supabase-project-ref
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# データ移行用（Service Role Key）。スクリプトやサーバーでのみ使用し、クライアントに公開しないこと。
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 予約確認メール送信（Gmail API / OAuth2）。Edge Function とローカルスクリプトの両方で使用。
# 1. Google Cloud Console でプロジェクトを作成し、Gmail API を有効化する。
# 2. 認証情報 → OAuth 2.0 クライアント ID を「デスクトップアプリ」で作成。Client ID / Client Secret を取得。
# 3. OAuth 2.0 Playground などで、スコープ https://www.googleapis.com/auth/gmail.send を付与して認証し、Refresh token を取得。
# 4. 送信元アドレスがリフレッシュトークンと異なる場合は GOOGLE_GMAIL_FROM_EMAIL を設定（任意）。
# GOOGLE_GMAIL_CLIENT_ID=xxx.apps.googleusercontent.com
# GOOGLE_GMAIL_CLIENT_SECRET=xxx
# GOOGLE_GMAIL_REFRESH_TOKEN=xxx
# GOOGLE_GMAIL_FROM_EMAIL=lifecasting.timecapsule@gmail.com
# GOOGLE_GMAIL_FROM_NAME=Amorétto LifeCastingstudio
