# Supabase project settings for local development / Vercel
#
# このファイルを .env.local などにコピーして値を設定してください。
# 実際の値は Supabase ダッシュボードの Project Settings > API から取得します。

VITE_SUPABASE_PROJECT_ID=your-supabase-project-ref
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# データ移行用（Service Role Key）。スクリプトやサーバーでのみ使用し、クライアントに公開しないこと。
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 予約確認メール送信（Resend API）。Edge Function とローカルスクリプトの両方で使用。
# 1. https://resend.com でアカウント作成・ドメイン認証を行う
# 2. API Keys から API キーを取得する
# 3. FROM_EMAIL はドメイン認証済みのアドレスを指定する
# RESEND_API_KEY=re_xxxxxxxxxx
# RESEND_FROM_EMAIL=noreply@yourdomain.com
# RESEND_FROM_NAME=Amorétto LifeCastingstudio
